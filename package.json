{
  "name": "api-rest-node-typescript",
  "version": "1.0.0",
  "main": "index.js",
  "author": "",
  "license": "MIT",
  "private": "false",
  "dependencies": {
    "@types/jest": "^30.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "http-status-codes": "^2.3.0",
    "jest": "^30.4.2",
    "knex": "^3.3.0",
    "ts-jest": "^29.4.12",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jiti": "^2.7.0",
    "sqlite3": "^6.0.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.65.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "build": "tsc",
    "test": "jest",
    "postinstall": "tsc",
    "production": "node ./build/index.js",
    "knex:migrate": "knex --knexfile ./src/server/database/knex/Enviroment.ts migrate:latest",
    "knex:rollback": "knex --knexfile ./src/server/database/knex/Enviroment.ts migrate:rollback",
    "knex:rollback-all": "knex --knexfile ./src/server/database/knex/Enviroment.ts migrate:rollback --all",
    "knex:seed": "knex --knexfile ./src/server/database/knex/Enviroment.ts seed:run"
  },
  "engines": {
    "node": "24.x"
  }
}
